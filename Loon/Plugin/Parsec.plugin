#!name = Parsec Split Routing
#!desc = Parsec API / WebSocket via PROXY; STUN and UDP P2P via DIRECT (macOS client port 9000).
#!author = @Horatio Xu
#!version = 1.0.0
#!date = 2026-10-08
#!homepage = https://github.com/hhhoratioxu/Proxy
#!system = macOS
#!type = normal

# Read before enabling:
# 1. Parsec (Mac) > Settings > Network > Client Port = 9000, then restart Parsec.
# 2. Loon plugin PROXY policy: choose your preferred TAG/other proxy group.
# 3. In Loon [General], set disable-stun = false if currently true.
# 4. Avoid higher-priority local rules that override these plugin rules.
# 5. UDP 9000 rule is based on the configured local source port; it does not
#    guarantee P2P establishment across CGNAT/firewalls or bypass all network interception.
# 6. This is for Parsec on the Mac as client, not for a Mac hosting sessions.
# 7. No MITM, script, or DNS overrides are included.

[Rule]
# Parsec STUN is direct. Put the exact domains before the general domain suffix.
DOMAIN,stun.parsec.app,DIRECT
DOMAIN,stun6.parsec.app,DIRECT

# P2P UDP stream: only traffic using the Parsec client port configured above.
AND,((PROTOCOL,UDP),(SRC-PORT,9000)),DIRECT

# Parsec login, presence, updates, avatars and other control-plane traffic.
DOMAIN-SUFFIX,parsec.app,PROXY
DOMAIN-SUFFIX,parsecgaming.com,PROXY
DOMAIN-SUFFIX,parsecusercontent.com,PROXY
