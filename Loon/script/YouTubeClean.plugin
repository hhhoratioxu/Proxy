#!name = YouTube Clean 1.2.7
#!desc = 兼容备用翻译回复并输出具体失败原因；去广告、双语字幕及底栏独立开关。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Loon/Docs/YouTubeClean.md
#!loon_version = 3.5.1(983)
#!date = 2026-10-19

[Argument]
REMOVE_ADS = switch,true,type=boolean,tag=去广告
TRANSLATE_CAPTIONS = switch,true,type=boolean,tag=字幕翻译
TARGET_LANGUAGE = select,"zh-Hans","zh-Hant","en","ja","ko",type=string,tag=翻译语言
FALLBACK_TRANSLATION = switch,true,type=boolean,tag=Google 备用翻译
BILINGUAL = switch,true,type=boolean,tag=原文与译文双语
AUTO_CAPTIONS = switch,true,type=boolean,tag=优先原生字幕轨道
HIDE_UPLOAD = switch,true,type=boolean,tag=隐藏底部发布＋
HIDE_SHORTS = switch,false,type=boolean,tag=隐藏底部 Shorts
DEEP_FILTER = switch,true,type=boolean,tag=深层广告与推广过滤
DIAGNOSTICS = switch,true,type=boolean,tag=输出结构诊断日志

[Script]
request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?\/youtubei\/v1\/(?:browse|guide|log_event)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/8cfd57baf23480d1f8ee84e4fea129741bd50dc6/Loon/script/YouTubeClean.js", {${REMOVE_ADS}, ${TRANSLATE_CAPTIONS}, ${TARGET_LANGUAGE}, ${FALLBACK_TRANSLATION}, ${BILINGUAL}, ${AUTO_CAPTIONS}, ${HIDE_UPLOAD}, ${HIDE_SHORTS}, ${DEEP_FILTER}, ${DIAGNOSTICS}}) with tag="YouTube Clean 1.2.7 请求", timeout=8
response if ${url} ~= /(?:^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?\/youtubei\/v1\/(?:player(?:\/ad_break)?|browse|next|search|guide|navigation\/resolve_url|reel\/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https:\/\/(?:www|m)\.youtube\.com(?::443)?\/api\/timedtext(?:\?.*)?$|^https:\/\/[a-zA-Z0-9-]+\.googlevideo\.com(?::443)?\/initplayback(?:\?.*)?$)/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/8cfd57baf23480d1f8ee84e4fea129741bd50dc6/Loon/script/YouTubeClean.js", {${REMOVE_ADS}, ${TRANSLATE_CAPTIONS}, ${TARGET_LANGUAGE}, ${FALLBACK_TRANSLATION}, ${BILINGUAL}, ${AUTO_CAPTIONS}, ${HIDE_UPLOAD}, ${HIDE_SHORTS}, ${DEEP_FILTER}, ${DIAGNOSTICS}}) with tag="YouTube Clean 1.2.7 响应", timeout=8, requires_body=true, binary_body_mode=true

[Mitm]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
