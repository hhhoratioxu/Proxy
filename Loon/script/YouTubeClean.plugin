#!name = YouTube Clean · 去广告与双语字幕
#!desc = 1.0.0 · 独立重写，发布＋与 Shorts 底栏分别可选隐藏。需 HTTPS 解密；真机效果待验收。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Loon/Docs/YouTubeClean.md
#!loon_version = 3.5.1(983)
#!date = 2026-10-16

[Argument]
REMOVE_ADS = switch,true,type=boolean,tag=去广告
TRANSLATE_CAPTIONS = switch,true,type=boolean,tag=字幕翻译
TARGET_LANGUAGE = select,"zh-Hans","zh-Hant","en","ja","ko",type=string,tag=翻译语言
BILINGUAL = switch,true,type=boolean,tag=原文与译文双语
AUTO_CAPTIONS = switch,true,type=boolean,tag=优先选择翻译字幕
HIDE_UPLOAD = switch,true,type=boolean,tag=隐藏底部发布＋
HIDE_SHORTS = switch,false,type=boolean,tag=隐藏底部 Shorts

[Script]
request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)\/youtubei\/v1\/(?:guide|log_event)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/749d68f4530323f924b3bd7a9cf1bc272d4bfeff/Loon/script/YouTubeClean.js", {${REMOVE_ADS}, ${TRANSLATE_CAPTIONS}, ${TARGET_LANGUAGE}, ${BILINGUAL}, ${AUTO_CAPTIONS}, ${HIDE_UPLOAD}, ${HIDE_SHORTS}}) with tag="YouTube Clean 请求", timeout=8
response if ${url} ~= /(?:^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)\/youtubei\/v1\/(?:player(?:\/ad_break)?|browse|next|search|guide|navigation\/resolve_url|reel\/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https:\/\/(?:www|m)\.youtube\.com\/api\/timedtext(?:\?.*)?$|^https:\/\/[a-zA-Z0-9-]+\.googlevideo\.com\/initplayback(?:\?.*)?$)/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/749d68f4530323f924b3bd7a9cf1bc272d4bfeff/Loon/script/YouTubeClean.js", {${REMOVE_ADS}, ${TRANSLATE_CAPTIONS}, ${TARGET_LANGUAGE}, ${BILINGUAL}, ${AUTO_CAPTIONS}, ${HIDE_UPLOAD}, ${HIDE_SHORTS}}) with tag="YouTube Clean 响应", timeout=8, requires_body=true, binary_body_mode=true

[Mitm]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
