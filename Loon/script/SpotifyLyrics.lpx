#!name = Spotify 双语歌词 · VerseLyrics
#!desc = 核心 3.1.8 · 适配 15。韩英旧原文缓存自动重查；单行异常不再丢弃整批译文，未成功行短期退避后重试。 保留补词、翻译与原生高亮。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Loon/Docs/SpotifyLyrics.md
#!loon_version = 3.5.1(983)
#!date = 2026-10-21

[Argument]
REPLACE_UNSYNCED = switch,true,type=boolean,tag=替换官方非同步歌词,desc=开启：官方只有静态歌词时尝试备用同步源；未匹配保留官方原词。关闭：保留官方静态歌词，完全无词时的补词及翻译仍正常。
NETWORK_MODE = select,"online","cache-only",type=string,tag=插件联网模式,desc=online 正常补词与翻译；cache-only 仅使用有效缓存，未缓存的歌曲无法补词，未缓存的句子不联网翻译。不影响 Spotify 自身联网。
FALLBACK_MODE = select,"synced","fast",type=string,tag=补词策略,desc=synced 默认继续寻找逐行时间轴；fast 对完全无词歌曲可返回首份核对通过的纯文本。“替换官方非同步歌词”开启时，两种模式都只用真实同步歌词升级官方静态歌词。
FALLBACK_OFFSET_MS = select,"0","-500","-1000","-2000","-5000","500","1000","2000","5000",type=string,tag=补词时间校正（毫秒）,desc=仅影响所有备用来源的逐行同步歌词。正数延后、负数提前，默认 0；不影响官方原词，无时间轴歌词不移动。
FETCH_ARTWORK_COLOR = switch,true,type=boolean,tag=联网获取专辑配色,desc=关闭可省去额外取色请求；已有配色仍可复用，否则使用中性灰，补词和翻译保留。
MEMORY_MODE = select,"standard","compact",type=string,tag=缓存容量,desc=standard 为 128 条和 64000 字符；compact 为 64 条和 32000 字符，旧歌更早淘汰，较长记录可能不缓存。
PREFERRED_SOURCE = select,"auto","lrclib","qq","netease","kugou","kuwo","lyricsovh",type=string,tag=优先歌词源,desc=仅 auto 补词模式生效；优先尝试所选来源，其他来源继续兜底，已有成功缓存优先。
TRANSLATION_ENABLED = switch,true,type=boolean,tag=歌词翻译,desc=开启后用插件译文替换官方译文
SOURCE_TRANSLATIONS = switch,true,type=boolean,tag=复用歌词源译文,desc=精确对齐的简体译文可省去翻译请求；关闭则使用翻译服务
TARGET_LANGUAGE = select,"zh-CN","zh-TW","en","ja","ko",type=string,tag=翻译目标语言
FALLBACK_PROVIDER = select,"auto","lrclib","qq","netease","kugou","kuwo","lyricsovh","off",type=string,tag=备用歌词来源
DISCOVER_MISSING = switch,true,type=boolean,tag=尝试补充无词入口,desc=尝试显示补充歌词，受客户端与来源收录限制

[Rewrite]
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[0-9A-Za-z]{22}(?:\/image\/[^?#\s]+)?\/?(?:\?.*)?$/ && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") && (${FALLBACK_PROVIDER} == "off" || ${FALLBACK_PROVIDER} ~= /^(?:auto|lrclib|qq|netease|kugou|kuwo|lyricsovh)$/) && ${TARGET_LANGUAGE} ~= /^(?:zh-CN|zh-TW|en|ja|ko|fr|de|es|pt|it|ru|ar|hi|id|vi|th|tr|nl|pl|sv|uk|he|fa|ms|el)$/ && (${TRANSLATION_ENABLED} == true || ${FALLBACK_PROVIDER} ~= /^(?:auto|lrclib|qq|netease|kugou|kuwo|lyricsovh)$/) && ${url} ~= /^(?![^?]*\?(?:(?!format=(?:json|protobuf)(?:&|$))[^&]*&)*format=json(?:&|$))/i && (${request.header['Accept']} == null || ${request.header['Accept']} ~= /^(?![\s\S]*(?:protobuf|octet-stream|json))[\s\S]*$/i) then request.header.del("If-None-Match") | request.header.del("If-Modified-Since") | request.header.set("Accept-Encoding", "identity") | request.header.set("Cache-Control", "no-cache") | request.header.set("Accept", "application/x-protobuf")
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[0-9A-Za-z]{22}(?:\/image\/[^?#\s]+)?\/?(?:\?.*)?$/ && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") && (${FALLBACK_PROVIDER} == "off" || ${FALLBACK_PROVIDER} ~= /^(?:auto|lrclib|qq|netease|kugou|kuwo|lyricsovh)$/) && ${TARGET_LANGUAGE} ~= /^(?:zh-CN|zh-TW|en|ja|ko|fr|de|es|pt|it|ru|ar|hi|id|vi|th|tr|nl|pl|sv|uk|he|fa|ms|el)$/ && (${TRANSLATION_ENABLED} == true || ${FALLBACK_PROVIDER} ~= /^(?:auto|lrclib|qq|netease|kugou|kuwo|lyricsovh)$/) then request.header.del("If-None-Match") | request.header.del("If-Modified-Since") | request.header.set("Accept-Encoding", "identity") | request.header.set("Cache-Control", "no-cache")
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:metadata\/4\/track\/[0-9a-f]{32}|extended-metadata\/v0\/extended-metadata\/?|scrollsita\/v1\/scroll\/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}\/?|user-customization-service\/v1\/customize\/?|bootstrap\/v1\/bootstrap\/?|v1\/customize\/?|context-resolve\/v1\/spotify(?::|%3[aA])[^?#\s\/]+\/?|connect-state\/v1\/devices\/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*\/?)(?:\?.*)?$/ && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") && (${FALLBACK_PROVIDER} == "off" || ${FALLBACK_PROVIDER} ~= /^(?:auto|lrclib|qq|netease|kugou|kuwo|lyricsovh)$/) && ${TARGET_LANGUAGE} ~= /^(?:zh-CN|zh-TW|en|ja|ko|fr|de|es|pt|it|ru|ar|hi|id|vi|th|tr|nl|pl|sv|uk|he|fa|ms|el)$/ && ${DISCOVER_MISSING} == true && ${FALLBACK_PROVIDER} ~= /^(?:auto|lrclib|qq|netease|kugou|kuwo|lyricsovh)$/ then request.header.del("If-None-Match") | request.header.del("If-Modified-Since") | request.header.set("Accept-Encoding", "identity") | request.header.set("Cache-Control", "no-cache")

[Script]
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[0-9A-Za-z]{22}(?:\/image\/[^?#\s]+)?\/?(?:\?.*)?$/ && (${response.status} == 200 || ${response.status} == 404) && (${response.header['Content-Length']} == null || ${response.header['Content-Length']} ~= /^(?:[0-9]{1,5}|1[0-9]{5}|2[0-5][0-9]{4}|26[01][0-9]{3}|2620[0-9]{2}|2621[0-3][0-9]|26214[0-4])$/) && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/dce3a071f048bd3a58711dc0440aa10c8c0b5401/Loon/script/SpotifyLyrics.js", {${TRANSLATION_ENABLED}, ${TARGET_LANGUAGE}, ${FALLBACK_PROVIDER}, ${DISCOVER_MISSING}, ${SOURCE_TRANSLATIONS}, ${PREFERRED_SOURCE}, ${MEMORY_MODE}, ${FETCH_ARTWORK_COLOR}, ${FALLBACK_OFFSET_MS}, ${FALLBACK_MODE}, ${NETWORK_MODE}, ${REPLACE_UNSYNCED}}) with tag="VerseLyrics Lyrics", timeout=12, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:metadata\/4\/track\/[0-9a-f]{32}|extended-metadata\/v0\/extended-metadata\/?|scrollsita\/v1\/scroll\/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}\/?|user-customization-service\/v1\/customize\/?|bootstrap\/v1\/bootstrap\/?|v1\/customize\/?|context-resolve\/v1\/spotify(?::|%3[aA])[^?#\s\/]+\/?|connect-state\/v1\/devices\/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*\/?)(?:\?.*)?$/ && ${response.status} == 200 && (${response.header['Content-Length']} == null || ${response.header['Content-Length']} ~= /^(?:[0-9]{1,5}|1[0-2][0-9]{4}|130[0-9]{3}|1310[0-6][0-9]|13107[0-2])$/) && (${request.header['x-verselyrics-internal']} == null || ${request.header['x-verselyrics-internal']} == "") then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/dce3a071f048bd3a58711dc0440aa10c8c0b5401/Loon/script/SpotifyLyrics.Entry.js", {${TRANSLATION_ENABLED}, ${TARGET_LANGUAGE}, ${FALLBACK_PROVIDER}, ${DISCOVER_MISSING}, ${SOURCE_TRANSLATIONS}, ${PREFERRED_SOURCE}, ${MEMORY_MODE}, ${FETCH_ARTWORK_COLOR}, ${FALLBACK_OFFSET_MS}, ${FALLBACK_MODE}, ${NETWORK_MODE}, ${REPLACE_UNSYNCED}}) with tag="VerseLyrics Entry", timeout=3, requires_body=true, binary_body_mode=true

[Mitm]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
