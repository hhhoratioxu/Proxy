#!name = YouTube Clean 1.2.0 · C 连接兼容版
#!desc = 1.2.0 C 连接兼容版 · 深层过滤，并拒绝四个 YouTube API 主机的 UDP/443 以测试 TCP 回退。三版只启用一个；实际广告效果待确认。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Loon/Docs/YouTubeClean.md
#!loon_version = 3.5.1(983)
#!date = 2026-10-17

[Argument]
REMOVE_ADS = switch,true,type=boolean,tag=去广告
TRANSLATE_CAPTIONS = switch,true,type=boolean,tag=字幕翻译
TARGET_LANGUAGE = select,"zh-Hans","zh-Hant","en","ja","ko",type=string,tag=翻译语言
BILINGUAL = switch,true,type=boolean,tag=原文与译文双语
AUTO_CAPTIONS = switch,true,type=boolean,tag=优先选择翻译字幕
HIDE_UPLOAD = switch,true,type=boolean,tag=隐藏底部发布＋
HIDE_SHORTS = switch,false,type=boolean,tag=隐藏底部 Shorts
DEEP_FILTER = switch,true,type=boolean,tag=深层广告与推广过滤
DIAGNOSTICS = switch,true,type=boolean,tag=输出结构诊断日志
PROFILE = select,"tcp",type=string,tag=当前测试方案

[Script]
request if ${url} ~= /^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?\/youtubei\/v1\/(?:browse|guide|log_event)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/4823b8a027838625386e481c08c10a5f1891f34b/Loon/script/YouTubeClean.js", {${REMOVE_ADS}, ${TRANSLATE_CAPTIONS}, ${TARGET_LANGUAGE}, ${BILINGUAL}, ${AUTO_CAPTIONS}, ${HIDE_UPLOAD}, ${HIDE_SHORTS}, ${DEEP_FILTER}, ${DIAGNOSTICS}, ${PROFILE}}) with tag="YouTube Clean 请求", timeout=8
response if ${url} ~= /(?:^https:\/\/(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?\/youtubei\/v1\/(?:player(?:\/ad_break)?|browse|next|search|guide|navigation\/resolve_url|reel\/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https:\/\/(?:www|m)\.youtube\.com(?::443)?\/api\/timedtext(?:\?.*)?$|^https:\/\/[a-zA-Z0-9-]+\.googlevideo\.com(?::443)?\/initplayback(?:\?.*)?$)/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/4823b8a027838625386e481c08c10a5f1891f34b/Loon/script/YouTubeClean.js", {${REMOVE_ADS}, ${TRANSLATE_CAPTIONS}, ${TARGET_LANGUAGE}, ${BILINGUAL}, ${AUTO_CAPTIONS}, ${HIDE_UPLOAD}, ${HIDE_SHORTS}, ${DEEP_FILTER}, ${DIAGNOSTICS}, ${PROFILE}}) with tag="YouTube Clean tcp 响应", timeout=8, requires_body=true, binary_body_mode=true

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,youtubei-att.googleapis.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,www.youtube.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,m.youtube.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT


[Mitm]
hostname = youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
