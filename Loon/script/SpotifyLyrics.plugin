#!name = Spotify 双语歌词 · VerseLyrics
#!desc = 核心 0.4.1 · 适配 1。使用插件译文替换官方译文；官方无词歌曲仍可能不显示，本次未修复该问题。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Loon/Docs/SpotifyLyrics.md
#!loon_version = 3.5.1(983)
#!date = 2026-10-16

[Argument]
TRANSLATION_ENABLED = switch,true,type=boolean,tag=歌词翻译,desc=开启后用插件译文替换官方译文
TARGET_LANGUAGE = select,"zh-CN","zh-TW","en","ja","ko",type=string,tag=翻译目标语言
FALLBACK_PROVIDER = select,"auto","lrclib","qq","netease","off",type=string,tag=备用歌词来源
DISCOVER_MISSING = switch,true,type=boolean,tag=尝试补充无词入口,desc=已知部分官方无词歌曲仍不显示

[Script]
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:color-lyrics\/v2\/track\/[0-9A-Za-z]{22}(?:\/image\/[^?#\s]+)?\/?|metadata\/4\/track\/[0-9a-f]{32}|extended-metadata\/v0\/extended-metadata\/?|scrollsita\/v1\/scroll\/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}\/?|user-customization-service\/v1\/customize\/?|bootstrap\/v1\/bootstrap\/?|v1\/customize\/?|context-resolve\/v1\/spotify(?::|%3[aA])[^?#\s\/]+\/?|connect-state\/v1\/devices\/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*\/?)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/c35a07c9a851cba4c9f33c9d421cb68cf36b0784/Loon/script/SpotifyLyrics.js", {${TRANSLATION_ENABLED}, ${TARGET_LANGUAGE}, ${FALLBACK_PROVIDER}, ${DISCOVER_MISSING}}) with tag="VerseLyrics 请求", timeout=3
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:color-lyrics\/v2\/track\/[0-9A-Za-z]{22}(?:\/image\/[^?#\s]+)?\/?|metadata\/4\/track\/[0-9a-f]{32}|extended-metadata\/v0\/extended-metadata\/?|scrollsita\/v1\/scroll\/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}\/?|user-customization-service\/v1\/customize\/?|bootstrap\/v1\/bootstrap\/?|v1\/customize\/?|context-resolve\/v1\/spotify(?::|%3[aA])[^?#\s\/]+\/?|connect-state\/v1\/devices\/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*\/?)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/c35a07c9a851cba4c9f33c9d421cb68cf36b0784/Loon/script/SpotifyLyrics.js", {${TRANSLATION_ENABLED}, ${TARGET_LANGUAGE}, ${FALLBACK_PROVIDER}, ${DISCOVER_MISSING}}) with tag="VerseLyrics 歌词", timeout=25, requires_body=true, binary_body_mode=true

[Mitm]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
