#!name = Apple 照片地图诊断 0.1.0
#!desc = 排查国内外照片地图偏移的数据源和接口；仅诊断，尚不修正定位。需 HTTPS 解密。日志不含精确坐标、照片或令牌。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/codex/apple-photos-map-diagnostics/Loon/Docs/ApplePhotosMapDiagnostic.md
#!loon_version = 3.5.1(983)
#!date = 2026-10-19

[Script]
request if ${url} ~= /^https:\/\/gspe35-ssl\.ls\.apple\.com(?::443)?\/geo_manifest\/dynamic\/config(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/155d5ab062042afce60d7a062e8996cdb23fde27/Loon/script/ApplePhotosMapDiagnostic.js") with tag="照片地图 资源请求诊断", timeout=3
response if ${url} ~= /^https:\/\/gspe35-ssl\.ls\.apple\.com(?::443)?\/geo_manifest\/dynamic\/config(?:\?[^#]*)?$/ && ${response.status} == 200 then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/155d5ab062042afce60d7a062e8996cdb23fde27/Loon/script/ApplePhotosMapDiagnostic.js") with tag="照片地图 数据源诊断", timeout=3, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/(?:gspe(?:19|19-2)-cn-ssl\.ls\.apple\.com(?::443)?\/tiles|gspe19(?:-kittyhawk)?-ssl\.ls\.apple\.com(?::443)?\/tile\.vf|gspe11-2-cn-ssl\.ls\.apple\.com(?::443)?\/2\/tiles|gspe11-ssl\.ls\.apple\.com(?::443)?\/tile)(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/155d5ab062042afce60d7a062e8996cdb23fde27/Loon/script/ApplePhotosMapDiagnostic.js") with tag="照片地图 瓦片请求诊断", timeout=3
request if ${url} ~= /^https:\/\/(?:dispatcher\.is\.autonavi\.com(?::443)?\/dispatcher|gsp-ssl\.ls\.apple\.com(?::443)?\/dispatcher\.arpc)(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/155d5ab062042afce60d7a062e8996cdb23fde27/Loon/script/ApplePhotosMapDiagnostic.js") with tag="照片地图 地点接口诊断", timeout=3
response if ${url} ~= /^https:\/\/(?:dispatcher\.is\.autonavi\.com(?::443)?\/dispatcher|gsp-ssl\.ls\.apple\.com(?::443)?\/dispatcher\.arpc)(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/hhhoratioxu/Proxy/155d5ab062042afce60d7a062e8996cdb23fde27/Loon/script/ApplePhotosMapDiagnostic.js") with tag="照片地图 地点响应诊断", timeout=3

[Mitm]
hostname = gspe35-ssl.ls.apple.com, gspe19-cn-ssl.ls.apple.com, gspe19-2-cn-ssl.ls.apple.com, gspe19-ssl.ls.apple.com, gspe19-kittyhawk-ssl.ls.apple.com, gspe11-2-cn-ssl.ls.apple.com, gspe11-ssl.ls.apple.com, dispatcher.is.autonavi.com, gsp-ssl.ls.apple.com
