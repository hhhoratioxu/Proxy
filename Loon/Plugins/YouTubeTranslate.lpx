#!name=YouTube Translate
#!desc=DualSubs v1.5.11 + Universal v1.7.5。源语言 AUTO 自动识别，目标固定简体中文；使用 Translate/Google 路径，避免依赖 YouTube 原生 tlang 自动翻译。
#!author=DualSubs / Horatio
#!homepage=https://dualsubs.github.io/guide/youtube
#!icon=https://github.com/DualSubs/YouTube/raw/main/src/assets/icon_rounded.png
#!tag=YouTube
#!system=iOS,iPadOS,macOS
#!version=1.5.11-horatio

[Rewrite]
^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$ reject-img

[Script]
http-request ^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.5.11/request.bundle.js, tag=DualSubs Player Request JSON, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-response ^https?:\/\/(www|m|tv)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.5.11/response.bundle.js, tag=DualSubs Player Response JSON, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.5.11/request.bundle.js, tag=DualSubs Player Request Proto, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.5.11/response.bundle.js, tag=DualSubs Player Response Proto, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.5.11/response.bundle.js, tag=DualSubs GetWatch Response Proto, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-request ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$ script-path=https://github.com/DualSubs/YouTube/releases/download/v1.5.11/request.bundle.js, tag=DualSubs TimedText Request, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-response ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=(Official|External) requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.7.5/Composite.Subtitles.response.bundle.js, tag=DualSubs Composite TimedText, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR
http-response ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext\?(.*)subtype=Translate requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/download/v1.7.5/Translate.response.bundle.js, tag=DualSubs Translate TimedText, argument=Type=Translate&Types=Translate&Languages[0]=AUTO&Languages[1]=ZH-HANS&AutoCC=true&Position=Forward&Vendor=Google&ShowOnly=false&LogLevel=ERROR

[MitM]
hostname=www.youtube.com, m.youtube.com, tv.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
