#!name = Spotify Mac 本地协议核对
#!desc = 临时测试；不改响应。只向本机记录无查询参数的路由模板和歌词可用性布尔值，不记录凭据或歌词。
#!author = Horatio Xu
#!system = macOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-14

[Script]
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\// then script("http://127.0.0.1:18765/observe.js") with tag="Spotify Mac Observe Request", timeout=1
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?!color-lyrics\/v2\/|metadata\/4\/|extended-metadata\/|scrollsita\/|user-customization-service\/|bootstrap\/|v1\/customize|context-resolve\/|connect-state\/)/ && (${response.header['Content-Length']} == null || ${response.header['Content-Length']} ~= /^(?:[0-9]{1,5}|1[0-2][0-9]{4}|130[0-9]{3}|1310[0-6][0-9]|13107[0-2])$/) then script("http://127.0.0.1:18765/observe.js") with tag="Spotify Mac Observe Response", timeout=1, requires_body=true, binary_body_mode=true

[Mitm]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
