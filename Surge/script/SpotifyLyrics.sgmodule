#!name = Spotify 双语歌词 · VerseLyrics
#!desc = 核心 0.4.14 · 适配 10。补齐缺专辑名时的歌词匹配；优先真实时间轴、纯文本作备用。保留六源补词、插件翻译、高亮和原有内存限制。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Surge/Docs/SpotifyLyrics.md
# 建议 Surge iOS 5.9.0+ / Mac 5.5.0+。
# 改设置时同步修改三条 Script 的 argument；翻译目标可改为 zh-TW。

[Script]
VerseLyrics-Request = type=http-request,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/(?:color-lyrics/v2/track/[0-9A-Za-z]{22}(?:/image/[^?#\s]+)?/?|metadata/4/track/[0-9a-f]{32}|extended-metadata/v0/extended-metadata/?|scrollsita/v1/scroll/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}/?|user-customization-service/v1/customize/?|bootstrap/v1/bootstrap/?|v1/customize/?|context-resolve/v1/spotify(?::|%3[aA])[^?#\s/]+/?|connect-state/v1/devices/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/0254972759e337336ea0ee1c537b0f2a1d3e044b/Surge/script/SpotifyLyrics.Request.js,timeout=3,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true,engine=jsc
VerseLyrics-Lyrics = type=http-response,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/color-lyrics/v2/track/[0-9A-Za-z]{22}(?:/image/[^?#\s]+)?/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/0254972759e337336ea0ee1c537b0f2a1d3e044b/Surge/script/SpotifyLyrics.js,requires-body=true,binary-body-mode=true,max-size=262144,timeout=12,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true,engine=webview
VerseLyrics-Entry = type=http-response,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/(?:metadata/4/track/[0-9a-f]{32}|extended-metadata/v0/extended-metadata/?|scrollsita/v1/scroll/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}/?|user-customization-service/v1/customize/?|bootstrap/v1/bootstrap/?|v1/customize/?|context-resolve/v1/spotify(?::|%3[aA])[^?#\s/]+/?|connect-state/v1/devices/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/0254972759e337336ea0ee1c537b0f2a1d3e044b/Surge/script/SpotifyLyrics.Entry.js,requires-body=true,binary-body-mode=true,max-size=131072,timeout=3,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true,engine=webview

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com
