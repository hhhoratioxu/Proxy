#!name = YouTube Clean 1.2.6
#!desc = YouTube 译文限流时使用 Google 备用翻译；保留去广告、双语字幕及底栏独立开关。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Surge/Docs/YouTubeClean.md
#!arguments = REMOVE_ADS:true,TRANSLATE_CAPTIONS:true,TARGET_LANGUAGE:zh-Hans,FALLBACK_TRANSLATION:true,BILINGUAL:true,AUTO_CAPTIONS:true,HIDE_UPLOAD:true,HIDE_SHORTS:false,DEEP_FILTER:true,DIAGNOSTICS:true
#!arguments-desc = HIDE_UPLOAD：隐藏底部发布＋；HIDE_SHORTS：隐藏底部 Shorts。true 隐藏，false 保留。REMOVE_ADS：去广告；TRANSLATE_CAPTIONS：翻译；TARGET_LANGUAGE：目标语言；BILINGUAL：双语；AUTO_CAPTIONS：优先原生轨道。

[General]
force-http-engine-hosts = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com

[Script]
YouTubeClean-request = type=http-request,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?/youtubei/v1/(?:browse|guide|log_event)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/e78e8be9aa072c241653ce25479ba4b54ba62aeb/Surge/script/YouTubeClean.js,timeout=8,argument=REMOVE_ADS={{{REMOVE_ADS}}}&TRANSLATE_CAPTIONS={{{TRANSLATE_CAPTIONS}}}&TARGET_LANGUAGE={{{TARGET_LANGUAGE}}}&FALLBACK_TRANSLATION={{{FALLBACK_TRANSLATION}}}&BILINGUAL={{{BILINGUAL}}}&AUTO_CAPTIONS={{{AUTO_CAPTIONS}}}&HIDE_UPLOAD={{{HIDE_UPLOAD}}}&HIDE_SHORTS={{{HIDE_SHORTS}}}&DEEP_FILTER={{{DEEP_FILTER}}}&DIAGNOSTICS={{{DIAGNOSTICS}}}
YouTubeClean-response = type=http-response,pattern=(?:^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?/youtubei/v1/(?:player(?:/ad_break)?|browse|next|search|guide|navigation/resolve_url|reel/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https://(?:www|m)\.youtube\.com(?::443)?/api/timedtext(?:\?.*)?$|^https://[a-zA-Z0-9-]+\.googlevideo\.com(?::443)?/initplayback(?:\?.*)?$),script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/e78e8be9aa072c241653ce25479ba4b54ba62aeb/Surge/script/YouTubeClean.js,timeout=8,requires-body=true,binary-body-mode=true,max-size=8388608,argument=REMOVE_ADS={{{REMOVE_ADS}}}&TRANSLATE_CAPTIONS={{{TRANSLATE_CAPTIONS}}}&TARGET_LANGUAGE={{{TARGET_LANGUAGE}}}&FALLBACK_TRANSLATION={{{FALLBACK_TRANSLATION}}}&BILINGUAL={{{BILINGUAL}}}&AUTO_CAPTIONS={{{AUTO_CAPTIONS}}}&HIDE_UPLOAD={{{HIDE_UPLOAD}}}&HIDE_SHORTS={{{HIDE_SHORTS}}}&DEEP_FILTER={{{DEEP_FILTER}}}&DIAGNOSTICS={{{DIAGNOSTICS}}}

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
