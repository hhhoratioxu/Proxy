#!name = YouTube Clean · 去广告与双语字幕
#!desc = 1.0.1 · 补齐主页与下拉列表去广告路径。保留双语字幕及发布＋、Shorts 独立开关；需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Surge/Docs/YouTubeClean.md
#!arguments = REMOVE_ADS:true,TRANSLATE_CAPTIONS:true,TARGET_LANGUAGE:zh-Hans,BILINGUAL:true,AUTO_CAPTIONS:true,HIDE_UPLOAD:true,HIDE_SHORTS:false
#!arguments-desc = HIDE_UPLOAD：隐藏底部发布＋；HIDE_SHORTS：隐藏底部 Shorts。true 隐藏，false 保留。REMOVE_ADS：去广告；TRANSLATE_CAPTIONS：翻译；TARGET_LANGUAGE：目标语言；BILINGUAL：双语；AUTO_CAPTIONS：优先翻译轨道。

[General]
force-http-engine-hosts = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com

[Script]
YouTubeClean-request = type=http-request,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)/youtubei/v1/(?:browse|guide|log_event)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/f9ed760ea6ba25b17511bc6dff64a3b761a4c3d6/Surge/script/YouTubeClean.js,timeout=8,argument=REMOVE_ADS={{{REMOVE_ADS}}}&TRANSLATE_CAPTIONS={{{TRANSLATE_CAPTIONS}}}&TARGET_LANGUAGE={{{TARGET_LANGUAGE}}}&BILINGUAL={{{BILINGUAL}}}&AUTO_CAPTIONS={{{AUTO_CAPTIONS}}}&HIDE_UPLOAD={{{HIDE_UPLOAD}}}&HIDE_SHORTS={{{HIDE_SHORTS}}}
YouTubeClean-response = type=http-response,pattern=(?:^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)/youtubei/v1/(?:player(?:/ad_break)?|browse|next|search|guide|navigation/resolve_url|reel/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?.*)?$|^https://[a-zA-Z0-9-]+\.googlevideo\.com/initplayback(?:\?.*)?$),script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/f9ed760ea6ba25b17511bc6dff64a3b761a4c3d6/Surge/script/YouTubeClean.js,timeout=8,requires-body=true,binary-body-mode=true,max-size=8388608,argument=REMOVE_ADS={{{REMOVE_ADS}}}&TRANSLATE_CAPTIONS={{{TRANSLATE_CAPTIONS}}}&TARGET_LANGUAGE={{{TARGET_LANGUAGE}}}&BILINGUAL={{{BILINGUAL}}}&AUTO_CAPTIONS={{{AUTO_CAPTIONS}}}&HIDE_UPLOAD={{{HIDE_UPLOAD}}}&HIDE_SHORTS={{{HIDE_SHORTS}}}

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
