#!name=美团外卖去广告
#!desc=v0.2.0 · 开屏接口、广告素材与配置缓存处理；Surge iOS 5.9.1+/Mac 5.5.1+。
#!author=Horatio Xu
#!homepage=https://github.com/hhhoratioxu/Proxy

[General]
force-http-engine-hosts = %APPEND% wmapi.meituan.com, img.meituan.net, p*.meituan.net, s3plus.meituan.net, flowplus.meituan.net

[Map Local]
^https?:\/\/wmapi\.meituan\.com(?::(?:80|443))?\/api\/v[0-9]+\/(?:startpicture\/?(?:\?[^#]*)?|openscreen\/?\?(?:[^&#]*&)*ad[A-Za-z0-9_]*(?:=[^&#]*)?(?:&[^#]*)?)$ data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8|Cache-Control:no-store"
^https?:\/\/img\.meituan\.net(?::(?:80|443))?\/bizad\/bizad_brandCpt_[0-9]+\.jpg(?:@[^/?#]+)?(?:\?[^#]*)?$ data-type=tiny-gif status-code=200 header="Cache-Control:no-store"
^https?:\/\/p[0-9]+\.meituan\.net(?::(?:80|443))?\/(?:bizad|brandCpt)\/[A-Za-z0-9_-]+\.jpg(?:@[^/?#]+)?(?:\?[^#]*)?$ data-type=tiny-gif status-code=200 header="Cache-Control:no-store"
^https?:\/\/(?:s3plus|flowplus)\.meituan\.net(?::(?:80|443))?\/v[0-9]+\/[A-Za-z0-9_-]+\/linglong\/[A-Za-z0-9_-]+\.(?:gif|jpg)(?:@[^/?#]+)?(?:\?[^#]*)?$ data-type=tiny-gif status-code=200 header="Cache-Control:no-store"
^https?:\/\/(?:s3plus|flowplus)\.meituan\.net(?::(?:80|443))?\/v[0-9]+\/[A-Za-z0-9_-]+\/linglong\/[A-Za-z0-9_-]+\.mp4(?:\?[^#]*)?$ data-type=text data="" status-code=200 header="Cache-Control:no-store"
^https?:\/\/s3plus\.meituan\.net(?::(?:80|443))?\/v[0-9]+\/mss_[A-Za-z0-9_-]+\/brandcpt-vedio\/[A-Za-z0-9_-]+\.(?:zip|mp4)(?:\?[^#]*)?$ data-type=text data="" status-code=200 header="Cache-Control:no-store"

[Script]
MeituanWaimaiRequest = type=http-request,pattern=^https?:\/\/wmapi\.meituan\.com(?::(?:80|443))?\/api\/v[0-9]+\/loadInfo\/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/0ab4530cf4c96408e4d81f5896a6d694a49be571/Surge/script/MeituanWaimai.js,timeout=8
MeituanWaimai = type=http-response,pattern=^https?:\/\/wmapi\.meituan\.com(?::(?:80|443))?\/api\/v[0-9]+\/loadInfo\/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/0ab4530cf4c96408e4d81f5896a6d694a49be571/Surge/script/MeituanWaimai.js,requires-body=true,max-size=2097152,timeout=8

[MITM]
hostname = %APPEND% wmapi.meituan.com, img.meituan.net, p*.meituan.net, s3plus.meituan.net, flowplus.meituan.net
