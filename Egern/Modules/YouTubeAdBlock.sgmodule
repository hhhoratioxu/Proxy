#!name=YouTube AdBlock 2026 (Egern)
#!desc=基于 2026-09-05 iOS HAR 实抓验证方案：拦截 rr*.googlevideo.com/initplayback，并使用固定版 Protobuf 响应净化核心；额外隐藏发布按钮和 Shorts。请在 Egern 直接按 Surge 模块导入。
#!author=Night / Feng-Feng1 / Maasea / Horatio
#!homepage=https://github.com/Feng-Feng1/surge
#!arguments=屏蔽上传按钮:true,屏蔽Shorts按钮:true
#!arguments-desc=- true：隐藏
- false：显示

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Map Local]
^https:\/\/rr[\w-]+\.googlevideo\.com\/initplayback(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
YouTube-响应广告净化 = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:browse|next|player|search|reel\/reel_watch_sequence|guide|get_watch)(?:\?.*)?$,requires-body=true,max-size=-1,binary-body-mode=true,script-path=https://raw.githubusercontent.com/Feng-Feng1/surge/main/YouTube-AdFilter-V2.txt?v=2.0.0-rc1,argument="{\"captionLang\":\"off\",\"blockUpload\":{{{屏蔽上传按钮}}},\"blockImmersive\":false,\"blockShorts\":{{{屏蔽Shorts按钮}}}}",timeout=60

[MITM]
hostname = %APPEND% rr*.googlevideo.com, youtubei.googleapis.com
