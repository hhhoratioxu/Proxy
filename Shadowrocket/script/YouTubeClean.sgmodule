#!name = YouTube Clean 1.2.8
#!desc = 减少正文复制与重复解析；去广告、字幕翻译及底栏独立开关。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Shadowrocket/Docs/YouTubeClean.md
# 修改设置时同步更新下方两条 Script 的 argument；true 开启，false 关闭。

[General]
force-http-engine-hosts = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com

[Script]
YouTubeClean-request = type=http-request,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?/youtubei/v1/(?:browse|guide|log_event)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/5fd57ddda63380d5c9c608ae2f26b6becb97dc12/Shadowrocket/script/YouTubeClean.js,timeout=8,argument=REMOVE_ADS=true&TRANSLATE_CAPTIONS=true&TARGET_LANGUAGE=zh-Hans&FALLBACK_TRANSLATION=true&BILINGUAL=true&AUTO_CAPTIONS=true&HIDE_UPLOAD=true&HIDE_SHORTS=false&DEEP_FILTER=true&DIAGNOSTICS=true
YouTubeClean-response = type=http-response,pattern=(?:^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)(?::443)?/youtubei/v1/(?:player(?:/ad_break)?|browse|next|search|guide|navigation/resolve_url|reel/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https://(?:www|m)\.youtube\.com(?::443)?/api/timedtext(?:\?.*)?$|^https://[a-zA-Z0-9-]+\.googlevideo\.com(?::443)?/initplayback(?:\?.*)?$),script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/5fd57ddda63380d5c9c608ae2f26b6becb97dc12/Shadowrocket/script/YouTubeClean.js,timeout=8,requires-body=true,binary-body-mode=true,max-size=8388608,argument=REMOVE_ADS=true&TRANSLATE_CAPTIONS=true&TARGET_LANGUAGE=zh-Hans&FALLBACK_TRANSLATION=true&BILINGUAL=true&AUTO_CAPTIONS=true&HIDE_UPLOAD=true&HIDE_SHORTS=false&DEEP_FILTER=true&DIAGNOSTICS=true

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
