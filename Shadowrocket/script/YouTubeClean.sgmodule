#!name = YouTube Clean · 去广告与双语字幕
#!desc = 1.0.0 · 独立重写，发布＋与 Shorts 底栏分别可选隐藏。需 HTTPS 解密；真机效果待验收。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Shadowrocket/Docs/YouTubeClean.md
# 修改设置时同步更新下方两条 Script 的 argument；true 开启，false 关闭。

[General]
force-http-engine-hosts = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com

[Script]
YouTubeClean-request = type=http-request,pattern=^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)/youtubei/v1/(?:guide|log_event)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/749d68f4530323f924b3bd7a9cf1bc272d4bfeff/Shadowrocket/script/YouTubeClean.js,timeout=8,argument=REMOVE_ADS=true&TRANSLATE_CAPTIONS=true&TARGET_LANGUAGE=zh-Hans&BILINGUAL=true&AUTO_CAPTIONS=true&HIDE_UPLOAD=true&HIDE_SHORTS=false
YouTubeClean-response = type=http-response,pattern=(?:^https://(?:youtubei(?:-att)?\.googleapis\.com|(?:www|m)\.youtube\.com)/youtubei/v1/(?:player(?:/ad_break)?|browse|next|search|guide|navigation/resolve_url|reel/(?:reel_watch_sequence|reel_item_watch)|get_watch|config|log_event)(?:\?.*)?$|^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?.*)?$|^https://[a-zA-Z0-9-]+\.googlevideo\.com/initplayback(?:\?.*)?$),script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/749d68f4530323f924b3bd7a9cf1bc272d4bfeff/Shadowrocket/script/YouTubeClean.js,timeout=8,requires-body=true,binary-body-mode=true,max-size=8388608,argument=REMOVE_ADS=true&TRANSLATE_CAPTIONS=true&TARGET_LANGUAGE=zh-Hans&BILINGUAL=true&AUTO_CAPTIONS=true&HIDE_UPLOAD=true&HIDE_SHORTS=false

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei-att.googleapis.com, www.youtube.com, m.youtube.com, *.googlevideo.com
