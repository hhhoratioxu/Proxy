#!name = Spotify 双语歌词 · VerseLyrics
#!desc = 核心 0.5.3 · 适配 12。降低播放器入口解析内存：JSON 单次扫描、Protobuf 按字段范围改写；搜索后仅保留候选 ID。保留六源补词、插件翻译与原生高亮，不增加缓存、预取或并发。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Shadowrocket/Docs/SpotifyLyrics.md
# 使用当前版本 Shadowrocket。
# 改设置时同步修改三条 Script 的 argument；翻译目标可改为 zh-TW。

[General]
force-http-engine-hosts = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com

[Script]
VerseLyrics-Request = type=http-request,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/(?:color-lyrics/v2/track/[0-9A-Za-z]{22}(?:/image/[^?#\s]+)?/?|metadata/4/track/[0-9a-f]{32}|extended-metadata/v0/extended-metadata/?|scrollsita/v1/scroll/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}/?|user-customization-service/v1/customize/?|bootstrap/v1/bootstrap/?|v1/customize/?|context-resolve/v1/spotify(?::|%3[aA])[^?#\s/]+/?|connect-state/v1/devices/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/ae2ed2b9b3c5ae2a7922bfa003c2687c8c0310f3/Shadowrocket/script/SpotifyLyrics.Request.js,timeout=3,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true&SOURCE_TRANSLATIONS=true
VerseLyrics-Lyrics = type=http-response,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/color-lyrics/v2/track/[0-9A-Za-z]{22}(?:/image/[^?#\s]+)?/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/ae2ed2b9b3c5ae2a7922bfa003c2687c8c0310f3/Shadowrocket/script/SpotifyLyrics.js,requires-body=true,binary-body-mode=true,max-size=262144,timeout=12,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true&SOURCE_TRANSLATIONS=true
VerseLyrics-Entry = type=http-response,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/(?:metadata/4/track/[0-9a-f]{32}|extended-metadata/v0/extended-metadata/?|scrollsita/v1/scroll/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}/?|user-customization-service/v1/customize/?|bootstrap/v1/bootstrap/?|v1/customize/?|context-resolve/v1/spotify(?::|%3[aA])[^?#\s/]+/?|connect-state/v1/devices/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/ae2ed2b9b3c5ae2a7922bfa003c2687c8c0310f3/Shadowrocket/script/SpotifyLyrics.Entry.js,requires-body=true,binary-body-mode=true,max-size=131072,timeout=3,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true&SOURCE_TRANSLATIONS=true

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com
