#!name = Spotify 双语歌词 · VerseLyrics
#!desc = 核心 0.4.1 · 适配 1。使用插件译文替换官方译文；官方无词歌曲仍可能不显示，本次未修复该问题。需 HTTPS 解密。
#!author = Horatio Xu
#!homepage = https://github.com/hhhoratioxu/Proxy/blob/main/Shadowrocket/Docs/SpotifyLyrics.md
# 使用当前版本 Shadowrocket。
# 改设置时同步修改两条 Script 的 argument；翻译目标可改为 zh-TW。

[General]
force-http-engine-hosts = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com

[Script]
VerseLyrics-Request = type=http-request,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/(?:color-lyrics/v2/track/[0-9A-Za-z]{22}(?:/image/[^?#\s]+)?/?|metadata/4/track/[0-9a-f]{32}|extended-metadata/v0/extended-metadata/?|scrollsita/v1/scroll/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}/?|user-customization-service/v1/customize/?|bootstrap/v1/bootstrap/?|v1/customize/?|context-resolve/v1/spotify(?::|%3[aA])[^?#\s/]+/?|connect-state/v1/devices/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/c35a07c9a851cba4c9f33c9d421cb68cf36b0784/Shadowrocket/script/SpotifyLyrics.js,timeout=3,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true
VerseLyrics-Response = type=http-response,pattern=^https://(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?/(?:color-lyrics/v2/track/[0-9A-Za-z]{22}(?:/image/[^?#\s]+)?/?|metadata/4/track/[0-9a-f]{32}|extended-metadata/v0/extended-metadata/?|scrollsita/v1/scroll/spotify(?::|%3[aA])track(?::|%3[aA])[0-9A-Za-z]{22}/?|user-customization-service/v1/customize/?|bootstrap/v1/bootstrap/?|v1/customize/?|context-resolve/v1/spotify(?::|%3[aA])[^?#\s/]+/?|connect-state/v1/devices/[0-9A-Za-z_-]{16}[0-9A-Za-z_-]*/?)(?:\?.*)?$,script-path=https://raw.githubusercontent.com/hhhoratioxu/Proxy/c35a07c9a851cba4c9f33c9d421cb68cf36b0784/Shadowrocket/script/SpotifyLyrics.js,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=25,argument=TRANSLATION_ENABLED=true&TARGET_LANGUAGE=zh-CN&FALLBACK_PROVIDER=auto&DISCOVER_MISSING=true

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com
